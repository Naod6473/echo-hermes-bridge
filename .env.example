# Copy to .env and fill in. No comments at the end of a line: put them on their own line.

# The Echo's IP address (give it a fixed one in your router)
ECHO_HOST=192.168.1.50
ECHO_PORT=26053
# Only if an ESPHome encryption key was ever set on the Echo
# ECHO_KEY=

# Your Hermes profile: its API server URL and its API_SERVER_KEY
HERMES_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=change-me
# Empty = the first model the gateway lists
# HERMES_MODEL=

# Voice. LANGUAGE is the speech-to-text language and picks the default instruction/fallback (en, fr...)
LANGUAGE=en
# tiny / base (fast) ... small (good balance) ... medium (accurate, slow without a GPU)
WHISPER_MODEL=small
# Piper voice file, e.g. voices/fr_FR-siwis-medium.onnx for French
PIPER_VOICE=voices/en_US-lessac-medium.onnx
# Wake word to activate on the Echo at start (matched against the installed ones: alexa, computer, hey_jarvis...)
# Empty = leave the Echo's choice as it is
WAKE_WORD=

# Fine tuning
# Seconds of silence that end a request (when the Echo's own "End of request" is off)
END_SILENCE=0.8
# A new Hermes conversation after this many minutes without a request
IDLE_MINUTES=30
# Port the Echo downloads the spoken replies from (open it on this machine's firewall)
HTTP_PORT=8765
# This machine's LAN IP as the Echo sees it (auto-detected)
# PUBLIC_IP=
# Custom texts (defaults depend on LANGUAGE)
# VOICE_INSTRUCTION=
# FALLBACK_MESSAGE=

[Unit]
Description=Echo Hermes Bridge (voice satellite for Hermes Agent)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/echo-hermes-bridge
ExecStart=/opt/echo-hermes-bridge/.venv/bin/python bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
